# Copy this file to .env and fill in your own values.

# --- Supabase Auth ---
# Only use the anon public key. Never put the service_role key here or in the repo.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# --- App ---
PORT=3000

# --- Postgres (Docker Compose, optional) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=appdb
# Inside docker-compose the DB host is the service name "db"; on the host use "localhost".
DATABASE_URL=postgresql://app:change_me@db:5432/appdb
STORE=postgres

# --- Redis (optional) ---
REDIS_URL=redis://redis:6379
