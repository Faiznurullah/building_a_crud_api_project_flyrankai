# Copy to .env and adjust. In docker-compose the DB host is the service name "db";
# when running the app directly on your host, use "localhost" instead.
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=appdb

# Storage selection: postgres | sqlite | memory
# Default when unset: postgres if DATABASE_URL is set, otherwise memory.
STORE=postgres
DATABASE_URL=postgresql://app:change_me@db:5432/appdb

# Optional Redis (stretch goal). Leave unset to disable.
REDIS_URL=redis://redis:6379

PORT=3000
