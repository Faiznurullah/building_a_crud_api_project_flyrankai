# Copy this file to .env and fill in your own values.

# --- Supabase Auth ---
# Only use the anon public key. Never put the service_role key here or in the repo.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# --- App ---
PORT=3000

# --- AI provider (OpenAI) ---
# Get a key at https://platform.openai.com/api-keys . Keep it secret; never commit it.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout in milliseconds (real abort, not just waiting).
AI_TIMEOUT_MS=10000
# Maximum retries for transient failures (total attempts = AI_MAX_RETRIES + 1).
AI_MAX_RETRIES=2
# Maximum accepted input length in characters.
AI_MAX_INPUT_CHARS=2000
# Set to "true" to require a Supabase bearer token on the AI endpoint.
AI_REQUIRE_AUTH=false

# --- Postgres (Docker Compose, optional) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=appdb
# Inside docker-compose the DB host is the service name "db"; on the host use "localhost".
DATABASE_URL=postgresql://app:change_me@db:5432/appdb
STORE=postgres

# --- Redis (optional) ---
REDIS_URL=redis://redis:6379
